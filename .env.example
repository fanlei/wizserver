# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will not be committed.

# Domain name for your private WizServer (without https://)
WIZ_DOMAIN=notes.example.com

# SSH login for your server (user@ip or SSH config host alias)
WIZ_SSH_HOST=deploy@your-server-ip

# Remote directory on the server where wizserver.sqlite, notes/, and attachments/ live
WIZ_DATA_DIR=/home/deploy/wizdata

# Remote directory on the server where the PHP app lives (index.php goes in <WIZ_WEB_ROOT>/public)
WIZ_WEB_ROOT=/var/www/wizserver

# Nginx site filename under /etc/nginx/sites-available/ and sites-enabled/
WIZ_NGINX_SITE=wiz

# Local WizQTClient profile folder on this computer
WIZ_LOCAL_DATA=~/.wiznote/user@example.com/data
